# ====================
# SMTP 서버 설정
# ====================

# SMTP 서버 주소 (예: smtp.gmail.com(구글), smtp.naver.com(네이버))
SMTP_HOST=your-smtp-host.example.com

# SMTP 포트 번호
# 일반적인 포트: 587 (TLS), 465 (SSL), 25 (비보안, 비추천)
SMTP_PORT=587

# 보안 연결 사용 여부
# 587 포트: false, 465 포트: true
SMTP_SECURE=false

# SMTP 인증을 위한 이메일 계정
SMTP_USER=your-email@example.com

# SMTP 인증을 위한 비밀번호 (Gmail의 경우 앱 비밀번호 사용 권장)
SMTP_PASS=your-email-password

# ====================
# 발신자 정보
# ====================
# 이메일을 보내는 사람의 정보를 입력해주세요.

# 발신자 이름 (선택사항, 따옴표로 감싸주세요)
FROM_NAME="당신의 이름"

# 발신자 이메일 주소 (SMTP_USER와 동일한 경우가 많음)
FROM_EMAIL=your-email@example.com

# ====================
# 수신자 설정
# ====================
# 이메일을 받을 수신자의 주소를 입력해주세요.
TO_EMAIL=recipient@example.com

# ====================
# 이메일 제목
# ====================
EMAIL_SUBJECT="이메일 제목"
